{
  "name": "sosg-signup-worker",
  "private": true,
  "description": "Signup Worker: first-party electronic signing (email-verified typed signature), private signed-agreement records (D1 + R2), Stripe Checkout gate. See ../_docs/ESIGN-SETUP.md",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:e2e": "node test/e2e.mjs .. test/output",
    "preview": "node test/preview.mjs ..",
    "db:migrate:local": "wrangler d1 migrations apply sosg-signups --local",
    "test:live": "node test/live.mjs",
    "bench:cpu": "node test/bench-cpu.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply sosg-signups --remote"
  },
  "devDependencies": {
    "@pdf-lib/standard-fonts": "1.0.0",
    "miniflare": "3.20250718.3",
    "playwright": "^1.48.0",
    "wrangler": "^3.90.0"
  },
  "type": "module"
}
